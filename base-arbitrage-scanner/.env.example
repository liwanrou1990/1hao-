# ===== Base flash-loan arbitrage scanner — copy to .env; never commit real values =====
# Base mainnet (chainId 8453) JSON-RPC. Comma-separate several URLs for automatic fallback. Archive access is needed for backtests.
BASE_RPC_URL=
# BASE_RPC_URLS=https://base-mainnet.g.alchemy.com/v2/KEY,https://mainnet.base.org
# Optional websocket for newHeads (polling is used otherwise)
BASE_WS_URL=
CHAIN_ID=8453

# Storage / output
DB_PATH=data/scanner.sqlite
REPORT_DIR=reports
LOG_LEVEL=info

# RPC protection
RPC_MAX_RPS=20
RPC_MAX_CONCURRENCY=6
RPC_RETRIES=4

# Scan parameters
AMOUNT_LADDER_USD=1000,10000,50000,100000,500000,1000000
MIN_POOL_TVL_USD=50000
MIN_NET_PROFIT_USD=1
SLIPPAGE_BUFFER_BPS=5
MAX_ROUTES_PER_BLOCK=400
ENABLE_MULTIHOP=true
DEDUPE_BLOCKS=10

# Gas model fallbacks (units) — quoter gasEstimate is preferred when available
GAS_UNITS_BASE=60000
GAS_UNITS_FLASHLOAN=140000
GAS_UNITS_V3_LEG=130000
GAS_UNITS_V2_LEG=95000

# Fork simulation: auto (anvil if installed, else hardhat node) | anvil | hardhat | none
FORK_PROVIDER=auto
FORK_PORT=8546
FORK_TIMEOUT_MS=90000

# Historical backtest sampling: evaluate every N blocks (Base = 2s blocks; 30 → one sample per minute)
BACKTEST_SAMPLE_EVERY_BLOCKS=30

# Offline deterministic fixture (no RPC). Results are labeled OFFLINE_FIXTURE and are NOT market data.
OFFLINE_FIXTURE=false

# Optional address overrides (verified on-chain at startup anyway)
# ADDR_UNISWAP_V3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
# ADDR_AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
