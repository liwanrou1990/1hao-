# ===== 复制为 .env 后填写；密钥只保存在本地环境变量，绝不提交到仓库 =====
# Bitget Wallet OpenAPI（ToB，需向 bgw_devsupport@bitget.com 申请）
BGW_API_KEY=
BGW_API_SECRET=
BGW_BASE_URL=https://bopenapi.bgwapi.io

# Massive（原 Polygon.io）美股分钟K线基准
MASSIVE_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com

# 数据源模式：auto | live | simulated
# auto：有密钥且探测通过时用 live，否则退回 simulated 并在所有输出标注 "SIMULATED"
BGWQ_DATA_MODE=auto

# 本地存储
BGWQ_DB_PATH=data_store/bgwq.duckdb
BGWQ_REPORT_DIR=reports_out

# 执行安全（V1 固定为研究模式；任何真实交易相关开关在 V1 中无效）
BGWQ_EXECUTION_MODE=research_only
