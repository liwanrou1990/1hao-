    {
      "id": "SafeOracleVault.SOLVENCY",
      "family": "collateral_solvency",
      "statement": "after any operation sequence, sum of `debtOf` <= LTV * value of sum of `collateralOf` at the valuation source's quiescent reading",
      "assumptions": [
        "the valuation source reflects a fair price when no transaction is in flight",
        "LTV is the constant used in the guarding comparison"
