      "id": "SafeOracleVault.ASSET_CONSERVATION.collateral",
      "family": "asset_conservation",
      "statement": "balanceOf(SafeOracleVault) of asset `collateral` >= sum over users of `collateralOf` minus assets legitimately paid out",
      "assumptions": [
        "the asset is a standard ERC20 without fee-on-transfer/rebasing",
        "`collateralOf` is the only accounting of user claims on this asset"
      ],
      "legitimate_exceptions": [
