# 复制为 .env（Docker）或 /etc/default/brando-pa-forward（systemd）或写入 launchd plist 的 EnvironmentVariables
PYTHONPATH=src
BRANDO_PA_INTERVAL_S=600               # 服务主循环间隔（秒）
BRANDO_ALERT_WEBHOOK=                  # 可选：告警 webhook（Slack/飞书等 incoming webhook）；留空则只写 alerts.jsonl
TZ=UTC
# 真实交易保持禁用：不要设置 BRANDO_LIVE_CONFIRM；config/brando_pa.yaml execution.live_trading 必须为 false（且本项目没有真实下单实现）
