  "formulas": {
    "buy": "fill = ref × (1 + slip_bps/1e4); fee = fill × qty × fee_bps/1e4; cash −= fill × qty + fee（ref：实时 Ask，否则最新已收盘 1h 收盘价=estimated）",
    "sell": "fill = ref × (1 − slip_bps/1e4); fee = fill × qty × fee_bps/1e4; cash += fill × qty − fee; realized += (fill − lot_cost) × qty − fee（ref：实时 Bid，否则估算）",
    "equity": "cash + Σ qty × mark（mark = 最新已收盘 1h 收盘价）",
    "unrealized": "Σ (mark − lot_fill_price) × qty（lot_fill_price 含买入滑点，不含买入手续费）",
    "liquidation": "cash + Σ qty × mark × (1 − slip) × (1 − fee)；= equity − 15 bps × 持仓市值（假设卖出成本，未发生）",
    "identity": "equity − initial = realized + unrealized − buy_fees"
  }
