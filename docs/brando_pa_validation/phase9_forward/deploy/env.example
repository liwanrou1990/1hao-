# 复制到 ~/.config/spot90/env（chmod 600）。所有密钥只放这里，不进代码、日志或页面。
SPOT90_ALERT_WEBHOOK=            # 可选：Slack/飞书/企业微信/ntfy 等 Webhook URL；为空则只写 alerts.log
SPOT90_DASHBOARD_URL=http://127.0.0.1:8501   # 健康检查用，探测 /_stcore/health
SPOT90_PORT=8501
SPOT90_BIND=127.0.0.1            # 只监听本机；远程访问经 Tailscale Serve/SSH 隧道，不直接公开
