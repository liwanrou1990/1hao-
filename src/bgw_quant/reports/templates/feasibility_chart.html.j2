<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><title>{{ symbol }} {{ day }} 历史可行性</title>
<script src="vendor/lightweight-charts.standalone.production.js" onerror="var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/lightweight-charts/4.1.3/lightweight-charts.standalone.production.min.js';document.head.appendChild(s)"></script>
<style>body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;margin:16px;color:#222}
.banner{background:#fff3cd;border:1px solid #ffe69c;padding:8px 12px;border-radius:6px;margin:8px 0}.bad{background:#f8d7da;border-color:#f1aeb5}
table{border-collapse:collapse;font-size:12.5px;margin:8px 0}th,td{border:1px solid #ddd;padding:3px 7px;text-align:right}th{background:#f0f0f0}
td:first-child,th:first-child{text-align:left}#chart{height:430px}#cum{height:150px}.pos{color:#2e7d32}.neg{color:#c62828}select{padding:4px 8px}
.kpi{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0}.kpi div{border:1px solid #ddd;border-radius:6px;padding:6px 10px;min-width:130px;font-size:12px}.kpi b{display:block;font-size:16px}</style></head><body>
<h1 style="font-size:19px">{{ symbol }} · {{ day }} · 历史可行性（成本模型 {{ cost_profile }}）</h1>
<div class="banner bad"><b>事后路径，不代表未来可复制收益。</b> 数据来源 <b>{{ source }}</b>{% if simulated %} —— <b>SIMULATED，非正式验证</b>{% endif %}。时间轴为美东时间。成交价 = 该根收盘价 ± 成本。</div>
<div>档位：<select id="cap"></select></div>
<div class="kpi" id="kpi"></div><div id="limits" class="banner" style="display:none"></div>
<div id="chart"></div><div style="font-size:12px;color:#666">B 累计净利润（按平仓时间）</div><div id="cum"></div>
<h3 style="font-size:14px">B 完整买卖点（按平仓时间排序）</h3><table id="trades"></table>
<h3 style="font-size:14px">至多 k 笔的最优净利润（单资金片）</h3><div id="bestk" class="banner"></div>
<script>
const candles={{ candles_json|safe }}; const payload={{ payload_json|safe }};
const sel=document.getElementById('cap'); payload.forEach((p,i)=>{const o=document.createElement('option');o.value=i;o.text=`${p.tier} · ${p.capital_usd.toLocaleString()} USD · 目标 ${p.target_usd.toFixed(0)}`;sel.appendChild(o)});
let cs, ln;
function draw(){
 const opts={layout:{background:{color:'#fff'},textColor:'#333'},grid:{vertLines:{color:'#eee'},horzLines:{color:'#eee'}},timeScale:{timeVisible:true,secondsVisible:false},localization:{locale:'zh-CN'}};
 const chart=LightweightCharts.createChart(document.getElementById('chart'),opts);
 cs=chart.addCandlestickSeries({upColor:'#26a69a',downColor:'#ef5350',borderVisible:false,wickUpColor:'#26a69a',wickDownColor:'#ef5350'});
 cs.setData(candles.map(c=>({time:c.time,open:c.open,high:c.high,low:c.low,close:c.close}))); chart.timeScale().fitContent();
 const c2=LightweightCharts.createChart(document.getElementById('cum'),opts); ln=c2.addLineSeries({color:'#1565c0',lineWidth:2}); window._c2=c2; update();
}
function update(){
 const r=payload[sel.value]; cs.setMarkers(r.markers); ln.setData(r.cum); window._c2.timeScale().fitContent();
 const k=[['目标',r.target_usd.toFixed(2)],['A 理论最大净收益',r.theoretical_net_usd.toFixed(2)+' ('+r.theoretical_trades+' 笔) '+(r.theoretical_met?'达标':'未达标')],['B 可实现最大净收益',r.executable_net_usd.toFixed(2)+' ('+(r.executable_return*100).toFixed(3)+'%)'],['资金片 / 单片',r.n_tranches+' / '+r.tranche_usd.toFixed(0)],['B 笔数 多/空',r.n_trades+' ('+r.n_long+'/'+r.n_short+')'],['达标所需笔数',r.trades_to_target?r.trades_to_target+' @ '+r.target_hit_ts.slice(11,16):'不可达'],['峰值占用',(r.peak_deployed_usd/r.capital_usd*100).toFixed(0)+'%'],['流动性已用',r.liquidity_used_ratio==null?'未知':(r.liquidity_used_ratio*100).toFixed(0)+'%'],['成本合计',r.cost_usd.toFixed(2)],['B 是否达标',r.executable_met?'<b class="pos">达标</b>':'<b class="neg">未达标</b>']];
 document.getElementById('kpi').innerHTML=k.map(x=>`<div>${x[0]}<b style="font-size:13px">${x[1]}</b></div>`).join('');
 const L=document.getElementById('limits'); L.style.display=r.limits.length?'block':'none'; L.innerHTML='<b>限制：</b><br>'+r.limits.join('<br>');
 let h='<tr><th>#</th><th>片</th><th>方向</th><th>开仓</th><th>参考价</th><th>成交价</th><th>平仓</th><th>参考价</th><th>成交价</th><th>投入</th><th>数量</th><th>成本</th><th>净盈亏</th><th>净收益</th><th>累计</th><th>持有</th></tr>';
 r.trades.forEach((x,i)=>{h+=`<tr><td>${i+1}</td><td>${x.tranche}</td><td>${x.direction==='long'?'多':'空'}</td><td>${x.open_ts.slice(11,16)}</td><td>${x.open_ref.toFixed(3)}</td><td>${x.open_exec.toFixed(3)}</td><td>${x.close_ts.slice(11,16)}</td><td>${x.close_ref.toFixed(3)}</td><td>${x.close_exec.toFixed(3)}</td><td>${x.size_usd.toFixed(0)}</td><td>${x.qty.toFixed(3)}</td><td>${x.cost_usd.toFixed(2)}</td><td class="${x.net_pnl_usd>=0?'pos':'neg'}">${x.net_pnl_usd.toFixed(2)}</td><td>${(x.net_ret*100).toFixed(3)}%</td><td>${x.cum_net_pnl_usd.toFixed(2)}</td><td>${x.hold_bars}</td></tr>`});
 if(!r.trades.length) h+='<tr><td colspan="16">无可执行交易</td></tr>'; document.getElementById('trades').innerHTML=h;
 document.getElementById('bestk').innerText=Object.entries(r.best_by_k).map(([k,v])=>`k≤${k}: ${Number(v).toFixed(0)}`).join('；');
}
sel.onchange=update; (function wait(){ if(window.LightweightCharts) draw(); else setTimeout(wait,100); })();
</script></body></html>
