<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><title>{{ strategy }} {{ tier }} {{ day }} 轮动路径</title>
<script src="vendor/lightweight-charts.standalone.production.js" onerror="var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/lightweight-charts/4.1.3/lightweight-charts.standalone.production.min.js';document.head.appendChild(s)"></script>
<style>body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;margin:16px;color:#222}
.banner{background:#fff3cd;border:1px solid #ffe69c;padding:8px 12px;border-radius:6px;margin:8px 0}.bad{background:#f8d7da;border-color:#f1aeb5}
table{border-collapse:collapse;font-size:12px;margin:8px 0}th,td{border:1px solid #ddd;padding:3px 6px;text-align:right}th{background:#f0f0f0}
td:first-child,th:first-child{text-align:left}#chart{height:420px}#cum{height:150px}.pos{color:#2e7d32}.neg{color:#c62828}select{padding:4px 8px}
.kpi{display:flex;gap:10px;flex-wrap:wrap;margin:8px 0}.kpi div{border:1px solid #ddd;border-radius:6px;padding:6px 10px;min-width:120px;font-size:12px}.kpi b{display:block;font-size:14px}</style></head><body>
<h1 style="font-size:18px">{{ name }} · {{ tier }} · {{ day }} · 因果轮动（C）路径</h1>
<div class="banner {{ 'bad' if simulated else '' }}">{% if simulated %}<b>SIMULATED 模拟行情，非正式验证。</b>{% endif %} 无未来信息的因果模拟，不是保证收益。时间轴为美东时间；加密货币为 24 小时（00:00–23:59），股票仅 09:30–16:00。</div>
<div class="kpi">{% for k, v in kpis %}<div>{{ k }}<b>{{ v }}</b></div>{% endfor %}</div>
<div>资产：<select id="asset"></select> <span class="muted" id="src"></span></div>
<div id="chart"></div><div style="font-size:12px;color:#666">当日累计净利润（全部资产合计，按分钟）</div><div id="cum"></div>
<h3 style="font-size:14px">切换记录</h3><table><tr><th>时间</th><th>从</th><th>到</th><th>依据</th><th>切换成本估计</th></tr>{% for s in switches %}<tr><td>{{ s.ts[11:16] }}</td><td>{{ s.from_symbol }}</td><td>{{ s.to_symbol }}</td><td style="text-align:left">{{ s.reason }}</td><td>{{ s.est_cost_usd|round(0) }}</td></tr>{% endfor %}{% if not switches %}<tr><td colspan="5">无切换</td></tr>{% endif %}</table>
<h3 style="font-size:14px">逐笔（按平仓时间）</h3><table id="trades"><tr><th>#</th><th>资产</th><th>方向</th><th>模式</th><th>开仓</th><th>均价</th><th>平仓</th><th>均价</th><th>投入</th><th>数量</th><th>成本</th><th>资金成本</th><th>净盈亏</th><th>净收益</th><th>持有</th><th>出场原因</th><th>累计</th></tr>
{% for t in trades %}<tr><td>{{ t.seq }}</td><td>{{ t.symbol }}</td><td>{{ '多' if t.direction == 'long' else '空' }}</td><td>{{ t.mode }}</td><td>{{ t.open_ts[11:16] }}</td><td>{{ t.avg_open|round(4) }}</td><td>{{ t.close_ts[11:16] }}</td><td>{{ t.avg_close|round(4) }}</td><td>{{ t.size_usd|round(0) }}</td><td>{{ t.qty|round(4) }}</td><td>{{ t.trading_cost_usd|round(2) }}</td><td>{{ t.funding_cost_usd|round(2) }}</td><td class="{{ 'pos' if t.net_pnl_usd >= 0 else 'neg' }}">{{ t.net_pnl_usd|round(2) }}</td><td>{{ (t.net_ret * 100)|round(3) }}%</td><td>{{ t.hold_bars }}</td><td style="text-align:left">{{ t.reason_exit }}</td><td>{{ t.cum_net_pnl_usd|round(2) }}</td></tr>{% endfor %}</table>
<script>
const assets={{ assets_json|safe }}; const cum={{ cum_json|safe }};
const sel=document.getElementById('asset'); Object.keys(assets).forEach(k=>{const o=document.createElement('option');o.value=k;o.text=k+' ('+assets[k].n_trades+' 笔)';sel.appendChild(o)});
let chart, cs;
function draw(){
 const opts={layout:{background:{color:'#fff'},textColor:'#333'},grid:{vertLines:{color:'#eee'},horzLines:{color:'#eee'}},timeScale:{timeVisible:true,secondsVisible:false},localization:{locale:'zh-CN'}};
 chart=LightweightCharts.createChart(document.getElementById('chart'),opts);
 cs=chart.addCandlestickSeries({upColor:'#26a69a',downColor:'#ef5350',borderVisible:false,wickUpColor:'#26a69a',wickDownColor:'#ef5350'});
 const c2=LightweightCharts.createChart(document.getElementById('cum'),opts); const ln=c2.addLineSeries({color:'#1565c0',lineWidth:2}); ln.setData(cum); c2.timeScale().fitContent();
 update();
}
function update(){ const a=assets[sel.value]; cs.setData(a.candles); cs.setMarkers(a.markers); chart.timeScale().fitContent(); document.getElementById('src').innerText='来源 '+a.source; }
sel.onchange=update; (function wait(){ if(window.LightweightCharts) draw(); else setTimeout(wait,100); })();
</script></body></html>
